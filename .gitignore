# =====================================================================
# 依赖 / 构建产物
# =====================================================================
node_modules/
.pnp
.pnp.js
dist/
build/
*.tsbuildinfo

# =====================================================================
# 环境变量 / 密钥（含令牌存根，禁止入库）
# =====================================================================
.env
.env.local
.env.*.local

# =====================================================================
# 日志
# =====================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =====================================================================
# 后端运行时
# =====================================================================
# 数据库（运行时生成）
backend/data/*.db
backend/data/*.db-*
backend/data/*.bak*
backend/data/backup/
backend/data/uploads/

# 模型与字典（体积大，运行时用 npm run models:fetch / models:fetch-asr 获取）
backend/models/ocr/*.onnx
backend/models/ocr/*.txt
backend/models/asr/

# 插件编译产物（boki-market: npm run build:server / build:client 生成）
boki-market/plugins/*/server/**/*.js
boki-market/plugins/*/client/index.js
boki-market/plugins/*/client/style.css

# =====================================================================
# 编辑器 / 系统
# =====================================================================
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# =====================================================================
# 工具 / IDE 配置
# =====================================================================
/.workbuddy
/.trae

# =====================================================================
# 杂项
# =====================================================================
coverage/
*.pem
npm-shrinkwrap.json

# =====================================================================
# 项目内部资产（本地仅存，不进公开仓库）
# =====================================================================
# 营销 / 分发：插件市场、启动脚本
# 注：官网 website/ 已改为公开托管（GitHub Pages，见 .github/workflows/pages.yml），不在此列
starts/

# 品牌 / 商标资产（含内部知识产权方案）
brand/

# 桌面版（Electron 壳 + 打包 / 发布脚本，仅本地）
desktop/*
!desktop/src
!desktop/scripts
!desktop/package.json
!desktop/package-lock.json
!desktop/electron-builder.yml
!desktop/installer-hooks.nsh
# 出厂市场配置：由 scripts/build-package.mjs 依据仓库根 .env 生成，不入库
desktop/src/marketplace.js

# 内部文档
docs/

# boki-market 是独立项目，其 docs/ 必须入库（上面的 docs/ 规则会按目录名匹配任意层级）
!boki-market/docs/
!boki-market/docs/**

# 本机已安装的插件（运行时由「插件市场」装入，不属于源码）
# 客户端不随包任何插件：新克隆的仓库插件目录为空，需要什么自己从市场装
backend/data/plugins/
/.dsh-acl-recovery
