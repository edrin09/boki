# =====================================================================
# 依赖 / 构建产物
# =====================================================================
node_modules/
.pnp
.pnp.js
dist/
build/
*.tsbuildinfo

# =====================================================================
# 环境变量 / 密钥（含令牌存根，禁止入库）
# =====================================================================
.env
.env.local
.env.*.local

# =====================================================================
# 日志
# =====================================================================
logs/
# 例外：操作日志页是源码，不是运行期日志目录（routes.ts 静态引用，缺了开箱即崩）
!frontend/src/views/system/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =====================================================================
# 后端运行时
# =====================================================================
# 数据库（运行时生成）
backend/data/*.db
backend/data/*.db-*
backend/data/*.bak*
backend/data/backup/
backend/data/uploads/
# 故障现场快照（排查用，含旧 -wal / 主库副本）
backend/data/_recovery*/
# 待重启生效的数据库恢复（运行时临时文件）
backend/data/.restore-pending.json
backend/data/*.restore-pending.db

# 模型与字典（体积大，运行时用 npm run models:fetch / models:fetch-asr 获取）
backend/models/ocr/*.onnx
backend/models/ocr/*.txt
backend/models/asr/

# 插件编译产物（boki-market: npm run build:server / build:client 生成）
boki-market/plugins/*/server/**/*.js
boki-market/plugins/*/client/index.js
boki-market/plugins/*/client/style.css

# =====================================================================
# 编辑器 / 系统
# =====================================================================
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# =====================================================================
# 工具 / IDE 配置
# =====================================================================
/.workbuddy
/.trae

# =====================================================================
# 杂项
# =====================================================================
coverage/
# 演示录制器临时产物（Chrome profile / 帧缓冲，由 push-tools 工具链生成）
/out/
*.pem
npm-shrinkwrap.json

# =====================================================================
# 项目内部资产（本地仅存，不进公开仓库）
# =====================================================================
# 营销 / 分发：插件市场、启动脚本（boki-market 为独立项目，仅本地维护）
starts/
boki-market/

# 官网：随仓库分发，由 .github/workflows/pages.yml 自动部署到 GitHub Pages
# 视频类大文件走 COS 外链（boki/demo/），仓库内只保留 assets/ 下的一份源文件

# 品牌 / 商标资产（含内部知识产权方案）
brand/

# 桌面版（Electron 壳 + 打包 / 发布脚本，仅本地）
desktop/*
!desktop/src
!desktop/scripts
!desktop/package.json
!desktop/package-lock.json
!desktop/electron-builder.yml
!desktop/installer-hooks.nsh
# 出厂市场配置：由 scripts/build-package.mjs 依据仓库根 .env 生成，不入库
desktop/src/marketplace.js
# 打包机上的本地验证脚本与它生成的样本（不是产品代码，不入库）
desktop/scripts/receipts-verify.mjs
desktop/scripts/output/

# 内部文档：整目录不入库
# 仅仓库根目录的 docs/（内部文档不入库）；不要写成 docs/，那会连 assets/docs 一起忽略
/docs/

# 本机已安装的插件（运行时由「插件市场」装入，不属于源码）
# 客户端不随包任何插件：新克隆的仓库插件目录为空，需要什么自己从市场装
backend/data/plugins/
/.dsh-acl-recovery

# 官网素材：未引用的历史截图不随仓库分发（本机保留）
website/assets/GitHub_repository_social_previ_*.png
