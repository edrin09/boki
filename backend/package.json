{
  "name": "boki-backend",
  "version": "1.0.0",
  "description": "BOKI - 开源财务软件 · 后端 API (NestJS + TypeORM + SQLite)",
  "author": "西安市未央区鹏云智码软件开发部（个体工商户）",
  "private": true,
  "license": "AGPL-3.0",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:reset": "ts-node -r tsconfig-paths/register scripts/reset-db.ts",
    "db:fix-filenames": "node scripts/fix-filename-mojibake.cjs",
    "models:fetch": "node scripts/fetch-ocr-models.mjs",
    "models:fetch-asr": "node scripts/fetch-asr-streaming-model.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.0",
    "@types/archiver": "^7.0.0",
    "@types/ws": "^8.18.2",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dayjs": "^1.11.13",
    "onnxruntime-node": "^1.30.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "sherpa-onnx-node": "^1.13.8",
    "typeorm": "^0.3.20",
    "ws": "^8.22.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
