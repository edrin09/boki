{
  "id": "report-pack",
  "name": "财务报表与经营看板",
  "version": "1.0.0",
  "apiVersion": "^1.0.0",
  "engines": { "boki": ">=1.0.0" },
  "kind": "report",
  "scopeMode": "scoped",
  "trust": "official",
  "author": "boki",
  "license": "Apache-2.0",
  "description": "资产负债表、利润表、票据台账、现金流量简表、费用结构分析、一键月结与经营看板",
  "dependencies": {
    "hr": "^1.0.0",
    "receipts": "^1.0.0",
    "income-expense": "^1.0.0"
  },
  "permissions": [
    "dashboard",
    "reports",
    "reports:balance-sheet",
    "reports:profit-loss",
    "reports:ledger",
    "reports:cash-flow",
    "reports:expense-analysis",
    "reports:monthly-close",
    "reports:overview"
  ],
  "contributes": {
    "server": "server/index.js",
    "client": "client/index.js",
    "routes": [
      {
        "path": "/dashboard",
        "name": "Dashboard",
        "component": "DashboardPage",
        "meta": { "title": "工作台", "permission": "dashboard" }
      },
      {
        "path": "/reports",
        "component": "__layout__",
        "redirect": "/reports/balance-sheet",
        "meta": { "title": "财务报表", "permission": "reports" },
        "children": [
          {
            "path": "balance-sheet",
            "name": "ReportBalanceSheet",
            "component": "ReportBalanceSheetPage",
            "meta": { "title": "资产负债表", "permission": "reports:balance-sheet" }
          },
          {
            "path": "profit-loss",
            "name": "ReportProfitLoss",
            "component": "ReportProfitLossPage",
            "meta": { "title": "利润表", "permission": "reports:profit-loss" }
          },
          {
            "path": "ledger",
            "name": "ReportLedger",
            "component": "ReportLedgerPage",
            "meta": { "title": "票据台账", "permission": "reports:ledger" }
          },
          {
            "path": "cash-flow",
            "name": "ReportCashFlow",
            "component": "ReportCashFlowPage",
            "meta": { "title": "现金流量简表", "permission": "reports:cash-flow" }
          },
          {
            "path": "expense-analysis",
            "name": "ReportExpenseAnalysis",
            "component": "ReportExpenseAnalysisPage",
            "meta": { "title": "费用结构分析", "permission": "reports:expense-analysis" }
          },
          {
            "path": "monthly-close",
            "name": "ReportMonthlyClose",
            "component": "ReportMonthlyClosePage",
            "meta": { "title": "一键月结", "permission": "reports:monthly-close" }
          }
        ]
      }
    ],
    "menu": [
      { "group": "dashboard", "title": "工作台", "path": "/dashboard", "permission": "dashboard" },
      { "group": "reports", "title": "资产负债表", "path": "/reports/balance-sheet", "permission": "reports:balance-sheet" },
      { "group": "reports", "title": "利润表", "path": "/reports/profit-loss", "permission": "reports:profit-loss" },
      { "group": "reports", "title": "票据台账", "path": "/reports/ledger", "permission": "reports:ledger" },
      { "group": "reports", "title": "现金流量简表", "path": "/reports/cash-flow", "permission": "reports:cash-flow" },
      { "group": "reports", "title": "费用结构分析", "path": "/reports/expense-analysis", "permission": "reports:expense-analysis" },
      { "group": "reports", "title": "一键月结", "path": "/reports/monthly-close", "permission": "reports:monthly-close" }
    ],
    "slots": []
  },
  "tables": []
}
