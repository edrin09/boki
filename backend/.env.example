# 应用配置
APP_NAME=简易财务软件
APP_PORT=3000
APP_PREFIX=api

# 数据库（SQLite 单文件）
DB_DATABASE=./data/financial.db
DB_LOGGING=false
# 自动同步表结构（开发用；生产建议设为 false）
DB_SYNCHRONIZE=true

# JWT
JWT_SECRET=financial-bs-change-me-in-production
JWT_EXPIRES_IN=8h

# 加密密钥文件（32 字节 hex 文本，存放于程序根目录）
# 缺失或与库不匹配时系统拒绝启动；请与数据库备份分开保管
# 默认：仓库根 vault.key（桌面版固定 C:\ProgramData\BOKI\vault.key）
# VAULT_KEY_FILE=./vault.key

# 加密状态标记（默认与数据库同目录的 vault.json）
# VAULT_FILE=./data/vault.json

# 仅回归测试：强制使用明文库，跳过密钥文件与加密
# DB_CIPHER=plain

# 跨域来源，多个用逗号分隔；* 表示全部
CORS_ORIGIN=*

# 默认管理员（首次初始化时创建）
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=123456
INIT_ADMIN_NICKNAME=系统管理员