# =====================================================================
# boki-market 环境变量示例（复制为 .env 后使用，服务器上权限 600）
#
# 注意：这里没有、也永远不会有 PLUGIN_MARKET_PRIVATE_KEY。
#       签名私钥只存在于开发机 / CI 的发布端，服务器进程与目录树都不持有。
# =====================================================================

# ---- 监听与对外地址 ----
# 默认只监听回环地址，由 nginx 反代；确需直连再改成 0.0.0.0
MARKET_HOST=127.0.0.1
MARKET_PORT=8789
MARKET_PUBLIC_BASE_URL=http://localhost:8789
# 索引里的 market 标识（客户端只校验签名，不依赖该值；多市场实例时用于区分）
MARKET_NAME=boki-official

# ---- 独立数据库（与财务库无关，进程只允许访问这个文件）----
MARKET_DB_FILE=./db/market.db

# ---- 制品目录（zip 制品）----
MARKET_DATA_DIR=./data
# 单次 zip 上传上限（字节），默认 64 MiB
MARKET_MAX_UPLOAD_BYTES=67108864

# ---- 授权码 HMAC 密钥（收费期启用；留空则收费插件不可下载）----
MARKET_LICENSE_SECRET=

# ---- 统计脱敏盐（只存 IP 哈希，不存原始 IP）----
MARKET_IP_HASH_SALT=__CHANGE_ME__

# ---- 签名公钥（服务端只验签，不签名）----
# 格式：keyId1:<raw-base64-32bytes>,keyId2:<base64>
MARKET_PUBLIC_KEYS=

# ---- 限流（每来源每分钟请求数，0 = 关闭）----
MARKET_RATE_LIMIT=120

# ---- 下载统计批量写入（SQLite 单写者，异步落库）----
MARKET_STATS_FLUSH_MS=1000
MARKET_STATS_BATCH_SIZE=50

# ---- 反向代理与 HTTPS ----
# 置于 nginx 之后时开启：客户端 IP 取 X-Forwarded-For 最后一个
MARKET_TRUST_PROXY=false
# 生产环境必须为 true：拒绝非 HTTPS 的公共请求（回环地址健康检查除外）
MARKET_REQUIRE_HTTPS=false

# ---- 日志级别：debug / info / warn / error / silent ----
MARKET_LOG_LEVEL=info
