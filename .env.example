# 复制为 .env 使用；完整说明见 docs/ 与 scripts 注释
# 应用配置
APP_PORT=3000
APP_PREFIX=api

# —— 应用身份与联系方式（桌面 / 后端 / 前端 / 官网多端统一源）——
APP_TITLE=BOKI
OFFICIAL_SITE=https://edrin09.github.io/boki/
WINDOW_TITLE=BOKI 开源财务软件 · github.com/edrin09/boki
PUBLISHER_NAME=
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_WECHAT=

# 数据库（SQLite 单文件）
DB_DATABASE=./data/financial.db
DB_LOGGING=false
DB_SYNCHRONIZE=true

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# 跨域来源，多个用逗号分隔；* 表示全部
CORS_ORIGIN=*

# 默认管理员（首次初始化时创建）
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=change-me
INIT_ADMIN_NICKNAME=系统管理员

# —— 插件市场（boki-market 独立服务端，见 boki-market/）——
# 远程市场地址（后端与桌面端同一来源；留空 = 只用本地插件目录（boki-market/plugins））
# 本地开发：先在 boki-market/ 里 npm start（默认 http://127.0.0.1:8789）
PLUGIN_MARKET_URL=http://127.0.0.1:8789
# 客户端验签公钥（keyId:<raw-base64 32字节>，逗号分隔；与市场服务端 MARKET_PUBLIC_KEYS 同源）
# 留空 = 暂不验签（仅传输层保护）；生产环境必须配置并随客户端发版内置
PLUGIN_MARKET_PUBLIC_KEYS=
